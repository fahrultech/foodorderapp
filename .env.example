# Copy to .env and adjust. Used by docker-compose and for local dev.
POSTGRES_USER=foodorder
POSTGRES_PASSWORD=foodo…rder
DATABASE_URL=postgresql://foodorder:foodorder@localhost:5432/foodorder
JWT_SECRET=change…tion
# Access token lifetime (short — the SPA renews via POST /api/auth/refresh).
# Format: <integer> followed by s, m, h or d. Defaults shown.
JWT_ACCESS_TTL=30m
# Opaque refresh-token lifetime; one row per session in `refresh_tokens`.
JWT_REFRESH_TTL=30d
# API log verbosity (pino): fatal|error|warn|info|debug|trace. Default info.
# Output is one JSON line per event/access on stdout; /api/health is never logged.
LOG_LEVEL=info
API_PORT=4000
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api
