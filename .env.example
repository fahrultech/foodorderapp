# Copy to .env and adjust. Used by docker-compose and for local dev.
POSTGRES_USER=foodorder
POSTGRES_PASSWORD=foodorder
DATABASE_URL=postgresql://foodorder:foodorder@localhost:5432/foodorder
JWT_SECRET=change-me-for-production
# Access token lifetime (short — the SPA renews via POST /api/auth/refresh).
# Format: <integer> followed by s, m, h or d. Defaults shown.
JWT_ACCESS_TTL=30m
# Opaque refresh-token lifetime; one row per session in `refresh_tokens`.
JWT_REFRESH_TTL=30d
# API log verbosity (pino): fatal|error|warn|info|debug|trace. Default info.
# Output is one JSON line per event/access on stdout; /api/health is never logged.
LOG_LEVEL=info
# --- Rate limiting (per client IP, sliding window) ---
# /auth credential endpoints (register+login+refresh share one counter):
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW_SEC=60
# Order creation/cancellation:
RATE_LIMIT_ORDERS_MAX=30
RATE_LIMIT_ORDERS_WINDOW_SEC=60
# Payment intents/captures (POST /payments, POST /payments/:id/capture):
RATE_LIMIT_PAYMENTS_MAX=10
RATE_LIMIT_PAYMENTS_WINDOW_SEC=60
# Set to 1 ONLY behind a proxy that overwrites X-Forwarded-For (then the
# bucket key is the first XFF hop; otherwise the raw socket IP is used).
# RATE_LIMIT_TRUST_PROXY=1
API_PORT=4000
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# --- Payments (Phase 5 abstraction) ---
# Which PaymentGateway adapter to mount. Only "mock" is implemented so far —
# an unknown value FAILS THE API AT BOOT (no silent fallback). Stripe/Xendit
# adapters land behind this same switch later (docs/ROADMAP.md).
PAYMENT_PROVIDER=mock
# Dev-only knob on the mock adapter: set to "fail" to make every capture
# DECLINE (exercises the failed-payment + retry-new-row path end to end).
# Any other value (default) settles captures successfully.
MOCK_PAY_GATEWAY_MODE=succeed
# Independent sibling for REFUNDS (Phase 5 refund flow): "fail" makes every
# refundIntent DECLINE while captures still succeed (the two knobs are
# separate ON PURPOSE so a live server can pay+capture then fail refunds).
# Any other value (default) settles refunds successfully.
MOCK_REFUND_GATEWAY_MODE=succeed
